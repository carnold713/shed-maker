# Postgres (Railway plugin provides this). Omit locally to use the in-memory dev store.
DATABASE_URL=postgresql://user:pass@localhost:5432/barn

# Clerk. Omit both locally to run as a single dev user (ADR-0002).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public origin, used for share links.
APP_URL=http://localhost:3000
# HMAC secret for share-link tokens (M4).
SHARE_TOKEN_SECRET=change-me
